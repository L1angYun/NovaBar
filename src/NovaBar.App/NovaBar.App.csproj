<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NovaBar.App</RootNamespace>
    <AssemblyName>NovaBar</AssemblyName>
    <Version>0.4.3</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NovaBar.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NovaBar.Core\NovaBar.Core.csproj" />
    <ProjectReference Include="..\NovaBar.Tray\NovaBar.Tray.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\NovaBar.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The WinUI build produces these files in TargetDir; the .NET publish
       pipeline does not otherwise include the application's XAML resources. -->
  <Target Name="PublishWinUiAppResources" AfterTargets="ComputeResolvedFilesToPublishList">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')"
           Text="Generated WinUI resource index '$(TargetDir)$(AssemblyName).pri' is missing. Build the application before publishing." />
    <ItemGroup>
      <_AppXamlPublishResource Include="$(TargetDir)$(AssemblyName).pri" />
      <_AppXamlPublishResource Include="$(TargetDir)**\*.xbf"
                               Exclude="$(TargetDir)publish\**\*;$(PublishDir)**\*" />
      <ResolvedFileToPublish Include="@(_AppXamlPublishResource)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
